{
  "name": "@rolandihms/helpdesk-desk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Standalone help desk: one Worker serving the agent API and a React UI, signed in with Cloudflare Access",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "types": "wrangler types --strict-vars false",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "test": "vitest run",
    "typecheck": "tsc -p . && tsc -p tsconfig.worker.json"
  },
  "dependencies": {
    "@rolandihms/helpdesk-client": "*",
    "@rolandihms/helpdesk-core": "*",
    "@rolandihms/helpdesk-worker": "*",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "^1.170.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.151.0"
  }
}
