// CF Helpdesk Worker configuration.
// `npm run setup` (packages/cli) renders a per-account copy: wrangler.<profile>.jsonc.
// Local dev (`wrangler dev`) works as-is: D1, R2 and Workflows are simulated locally.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cf-helpdesk",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Database driver compiled into the bundle: "d1" | "postgres" | "mysql" | "planetscale" | "all".
  // Unused drivers are dropped at build time (pg + mysql2 + PlanetScale ≈ 1.4 MB). See docs/DATABASE.md.
  "define": { "__HELPDESK_DB_DRIVER__": "\"d1\"" },

  // Inbound addresses routed to this Worker. `wrangler deploy` creates the Email Routing rules.
  // Top-level only (cannot be set per env). Uncomment after running setup:
  // "addresses": ["support@example.com"],

  "send_email": [{ "name": "EMAIL" }],

  // Workers AI, used by the default LLM classifier (always runs remotely, even in wrangler dev).
  "ai": { "binding": "AI" },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cf-helpdesk",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/migrations/sqlite"
    }
  ],

  "r2_buckets": [{ "binding": "MAIL", "bucket_name": "cf-helpdesk-mail" }],

  "workflows": [
    {
      "binding": "INBOUND_WORKFLOW",
      "name": "cf-helpdesk-inbound",
      "class_name": "InboundEmailWorkflow"
    }
  ],

  // Postgres / MySQL instead of D1: set DB_DRIVER and add a Hyperdrive binding (see docs/DATABASE.md).
  // "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<hyperdrive-id>", "localConnectionString": "postgres://..." }],

  "vars": {
    // Optional runtime override; must match the build-time driver above unless that is "all".
    "DB_DRIVER": "d1",
    // "send": acknowledge via Email Sending (Workers Paid, any recipient).
    // "reply": acknowledge via message.reply() in the email handler (Free plan, DMARC-passing senders only).
    // "off": no acknowledgements.
    "ACK_MODE": "send",
    // "raw": build MIME ourselves (full header control). "builder": use the structured send() API.
    "EMAIL_SEND_FORMAT": "raw",
    // Auto-create a mailbox on first email to an unknown address (dev convenience). Otherwise reject.
    "AUTO_CREATE_MAILBOXES": "false",
    "DEFAULT_REF_PREFIX": "TKT",
    // Workers AI model for classification (must support JSON mode) and optional AI Gateway id.
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "AI_GATEWAY_ID": "",
    // Optional integrations (empty = off). Secrets: `wrangler secret put GITHUB_TOKEN` / `WEBHOOK_SECRET`.
    // GitHub issues for code-related bug tickets, e.g. "your-org/your-app" (private repos only by default).
    "GITHUB_REPO": "",
    // Signed webhook to another system on github.issue.created / ticket.classified, e.g. "https://ops.example/hooks".
    "WEBHOOK_URL": "",
    // Agent sign-in via Cloudflare Access (docs/AGENT-API.md). Team domain, e.g. "acme" or
    // "acme.cloudflareaccess.com", and the Access application's AUD tag. Empty = Access login off.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    // Embedding (docs/EMBEDDING.md): "on" lets a host app call the API over a service binding with
    // X-Helpdesk-Service-Key (secret HELPDESK_SERVICE_KEY) and an X-Helpdesk-Principal identity.
    "TRUSTED_PRINCIPAL": "",
    // Prefix for every table, e.g. "hd_", when sharing a database with another app. Must match the
    // prefix the migrations were generated with. Empty = no prefix.
    "TABLE_PREFIX": ""
  }
}
